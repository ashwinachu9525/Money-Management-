generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  incomes       Income[]
  expenses      Expense[]
  emis          EMI[]
  bills         Bill[]
  bankAccounts  BankAccount[]
  goals         Goal[]
  aiInsights    AIInsight[]
  notifications Notification[]
  creditCards   CreditCard[]
  savings       Saving[]
}

model Income {
  id            String       @id @default(cuid())
  userId        String
  bankAccountId String?
  sourceName    String
  companyName   String?
  category      String
  amount        Float
  date          DateTime
  notes         String?
  isRecurring   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
}

model Expense {
  id            String       @id @default(cuid())
  userId        String
  bankAccountId String?
  category      String
  amount        Float
  date          DateTime
  notes         String?
  isRecurring   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
}

model EMI {
  id              String   @id @default(cuid())
  userId          String
  name            String
  bank            String
  totalLoan       Float
  emiAmount       Float
  startDate       DateTime
  endDate         DateTime
  remainingMonths Int
  interestRate    Float
  notes           String?

  // Pre-EMI fields
  isPreEmi           Boolean   @default(false)
  propertyName       String?
  sanctionDate       DateTime?
  expectedCompletion DateTime?
  builderName        String?

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  slabs     DisbursementSlab[]
}

model DisbursementSlab {
  id                String    @id @default(cuid())
  emiId             String
  slabNumber        Int
  amount            Float
  releaseDate       DateTime?
  constructionStage String
  remarks           String?
  status            String // 'PENDING' or 'DISBURSED'
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  emi               EMI       @relation(fields: [emiId], references: [id], onDelete: Cascade)
}

model Bill {
  id        String   @id @default(cuid())
  userId    String
  name      String
  dueDate   DateTime
  amount    Float
  status    String // PENDING, PAID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BankAccount {
  id          String    @id @default(cuid())
  userId      String
  bankName    String
  accountNick String
  last5Digits String
  balance     Float
  accountType String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomes     Income[]
  expenses    Expense[]
}

model Goal {
  id            String   @id @default(cuid())
  userId        String
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  startDate     DateTime
  targetDate    DateTime
  priority      String // LOW, MEDIUM, HIGH
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIInsight {
  id        String   @id @default(cuid())
  userId    String
  insight   String
  type      String // SPENDING, SAVING, BUDGET, etc.
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditCard {
  id               String                @id @default(cuid())
  userId           String
  bank             String
  name             String
  last4Digits      String
  creditLimit      Float
  billingCycleDate Int
  dueDate          Int
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  statements       CreditCardStatement[]
}

model CreditCardStatement {
  id              String     @id @default(cuid())
  creditCardId    String
  month           Int
  year            Int
  statementAmount Float
  minimumDue      Float
  status          String     // 'PENDING', 'PAID_MINIMUM', 'PAID_FULL'
  paidAmount      Float      @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  creditCard      CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
}

model Saving {
  id                 String    @id @default(cuid())
  userId             String
  name               String    // e.g., "LIC Jeevan Anand", "Kotak Future Secure", "SBI Bluechip MF", "Kotak Stocks", "Fixed Deposit"
  category           String    // e.g., "LIC / Insurance Policy", "Mutual Funds", "Stocks / Equity", "Fixed Deposit / RD", "PPF / NPS", "Government Scheme", "Other Savings"
  institution        String?   // e.g., "LIC India", "Kotak Life Insurance", "Zerodha", "HDFC Bank"
  policyNumber       String?   // Policy Number / Account Number / Folio Number (Optional)
  frequency          String    @default("MONTHLY") // "MONTHLY", "QUARTERLY", "HALF_YEARLY", "YEARLY", "ONE_TIME"
  contributionAmount Float     // Contribution amount per frequency (e.g. ₹5,000/month or ₹50,000/year)
  totalInvestment    Float     // Total accumulated investment / total amount paid to date
  currentValue       Float?    // Optional current valuation / return value
  startDate          DateTime  // Investment / Policy start date
  maturityDate       DateTime? // Optional maturity date / policy end date
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
